{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npx esbuild src/app-server.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/_server.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.cjs": {
      "maxDuration": 30,
      "includeFiles": "{api/_server.cjs,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
